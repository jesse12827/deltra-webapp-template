# Non-secret configuration. Installed by the Approver as /etc/webapp/webapp.env
# (mode 0640, owner root, group webapp). Never put secrets in this file.
APP_ENV=production
APP_ADDR=127.0.0.1:8080
BASE_URL=https://webapp.example.deltra
# Peer authentication over the local socket as webapp_app (see runbook, pg_ident map).
DATABASE_URL=postgres:///webapp?host=/var/run/postgresql&user=webapp_app
AUTH_MODE=entra
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
SESSION_IDLE=30m
SESSION_ABSOLUTE=8h
LOG_LEVEL=info
